{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start AutoHire backend",
            "type": "npm",
            "script": "start",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Start Python FastAPI backend",
            "type": "shell",
            "command": "python",
            "args": [
                "backendreal.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PORT": "5501"
                }
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}