{
    "version": 2,
    "builds": [
        {
            "src": "Dockerfile",
            "use": "@vercel/docker"
        }
    ],
    "env": {
        "HOST": "127.0.0.1"
    },
    "rewrites": [
        {
            "source": "/analyzer",
            "destination": "/api/analyzer.py"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        }
    ]
}