{
    "version": 2,
    "builds": [
        {
            "src": "Dockerfile",
            "use": "@vercel/docker"
        }
    ],
    "rewrites": [
        {
            "source": "/analyzer",
            "destination": "/api/analyzer.py"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        }
    ]
}